{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && VITE_DEPLOYED=true npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/proxy.mjs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/aressim/api/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/api/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/aressim/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/aressim/logo.png", "destination": "/logo.png" },
    { "source": "/aressim", "destination": "/index.html" },
    { "source": "/aressim/", "destination": "/index.html" },
    { "source": "/aressim/:path*", "destination": "/index.html" }
  ]
}
